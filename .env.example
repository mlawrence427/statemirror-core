# Database connection
DATABASE_URL=postgres://statemirror:statemirror@localhost:5432/statemirror

# Server port
PORT=8080

# Maximum payload size in bytes (default 1MB)
MAX_PAYLOAD_BYTES=1048576

# API keys (comma-separated)
# Keys starting with "smr_" for read, "smw_" for write (convention only)
READ_API_KEYS=smr_test_read_key_123
WRITE_API_KEYS=smw_test_write_key_456

# Logging level: fatal, error, warn, info, debug, trace
LOG_LEVEL=info

# Optional: clean expired idempotency keys on startup (true/false)
CLEANUP_ON_STARTUP=true

# Optional: overrides /v1/health version field for this v1.0.0 release
APP_VERSION=1.0.0
