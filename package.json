{
  "name": "statemirror",
  "version": "0.1.0",
  "description": "A self-hosted, write-once ledger for decision state snapshots",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "test": "node --experimental-test-coverage --test tests/*.test.ts --import tsx",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "keywords": [
    "state",
    "snapshot",
    "ledger",
    "immutable",
    "audit"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/sensible": "^5.6.0",
    "dotenv": "^17.2.3",
    "fastify": "^4.28.1",
    "pg": "^8.12.0",
    "pino": "^9.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.12",
    "@types/pg": "^8.11.6",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
